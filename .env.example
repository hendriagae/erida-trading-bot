# ============================================================
# .env — API Keys & Konfigurasi Rahasia
# JANGAN upload file ini ke internet/GitHub!
# ============================================================

# Binance API (isi setelah buat API key di Binance)
BINANCE_API_KEY=isi_api_key_kamu_disini
BINANCE_SECRET_KEY=isi_secret_key_kamu_disini

# Mode: paper = simulasi | live = uang nyata
BOT_MODE=paper

# Testnet: true = gunakan testnet Binance (aman untuk belajar)
TESTNET=true

# Telegram Bot (isi setelah setup bot di @BotFather)
TELEGRAM_BOT_TOKEN=isi_token_telegram_kamu_disini
TELEGRAM_CHAT_ID=isi_chat_id_kamu_disini
